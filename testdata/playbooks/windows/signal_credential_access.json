{
 "playbook": "signal_credential_access",
 "fires": [
  {
   "rule": "LSASS Dump Tool",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Users\\Public\\procdump64.exe",
      "CommandLine": "procdump64.exe -accepteula -ma lsass.exe C:\\Users\\Public\\l.dmp",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "LSASS Dump Tool",
   "events": [
    {
     "fields": {
      "windows.event_id": 1,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "Image": "C:\\Users\\Public\\m.exe",
      "CommandLine": "\"m.exe\" \"privilege::debug\" \"sekurlsa::logonpasswords\" exit",
      "User": "CORP\\alice"
     }
    }
   ]
  },
  {
   "rule": "Comsvcs LSASS Dump",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\rundll32.exe",
      "CommandLine": "rundll32.exe C:\\Windows\\System32\\comsvcs.dll, MiniDump 624 C:\\temp\\out.dmp full",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "LSASS Process Access",
   "events": [
    {
     "fields": {
      "windows.event_id": 10,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "SourceImage": "C:\\Users\\Public\\tool.exe",
      "TargetImage": "C:\\Windows\\System32\\lsass.exe",
      "GrantedAccess": "0x1010"
     }
    }
   ]
  },
  {
   "rule": "SAM Registry Export",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\reg.exe",
      "CommandLine": "reg save HKLM\\SAM C:\\Users\\Public\\sam.save",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "NTDS Access",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\ntdsutil.exe",
      "CommandLine": "ntdsutil \"ac i ntds\" \"ifm\" \"create full C:\\temp\\ifm\" q q",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "NTDS Access",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\vssadmin.exe",
      "CommandLine": "vssadmin create shadow /for=C:",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "Credential Manager Query",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\cmdkey.exe",
      "CommandLine": "cmdkey /list",
      "SubjectUserName": "alice"
     },
     "t": 0
    },
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\vaultcmd.exe",
      "CommandLine": "vaultcmd /listcreds:\"Windows Credentials\"",
      "SubjectUserName": "alice"
     },
     "t": 5
    },
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\cmdkey.exe",
      "CommandLine": "cmdkey /list:TERMSRV/*",
      "SubjectUserName": "alice"
     },
     "t": 10
    }
   ]
  }
 ],
 "near_miss": [
  {
   "name": "procdump on a normal process",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\tools\\procdump.exe",
      "CommandLine": "procdump -ma notepad.exe",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "name": "reg export of a software key",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\reg.exe",
      "CommandLine": "reg export HKLM\\Software\\Vendor C:\\temp\\vendor.reg",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "name": "defender reading lsass",
   "events": [
    {
     "fields": {
      "windows.event_id": 10,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "SourceImage": "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\4.18\\MsMpEng.exe",
      "TargetImage": "C:\\Windows\\System32\\lsass.exe",
      "GrantedAccess": "0x1010"
     }
    }
   ]
  },
  {
   "name": "one cmdkey listing",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\cmdkey.exe",
      "CommandLine": "cmdkey /list",
      "SubjectUserName": "alice"
     }
    }
   ]
  }
 ]
}
