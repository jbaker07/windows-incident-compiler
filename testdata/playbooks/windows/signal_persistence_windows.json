{
 "playbook": "signal_persistence_windows",
 "fires": [
  {
   "rule": "Run Key Points to Script or Temp Path",
   "events": [
    {
     "fields": {
      "windows.event_id": 13,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "TargetObject": "HKU\\S-1-5-21-1-2-3-1105\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\Updater",
      "Details": "wscript.exe C:\\Users\\Public\\u.vbs",
      "Image": "C:\\Windows\\System32\\reg.exe"
     }
    }
   ]
  },
  {
   "rule": "File Dropped in Startup Folder",
   "events": [
    {
     "fields": {
      "windows.event_id": 11,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "TargetFilename": "C:\\Users\\alice\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\update.lnk",
      "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
     }
    }
   ]
  },
  {
   "rule": "WMI Event Consumer Created",
   "events": [
    {
     "fields": {
      "windows.event_id": 20,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "Operation": "Created",
      "Type": "Command Line",
      "Name": "Updater",
      "Destination": "powershell.exe -nop -c iex(gc C:\\Users\\Public\\p.txt)"
     }
    }
   ]
  },
  {
   "rule": "WMI Filter to Consumer Binding",
   "events": [
    {
     "fields": {
      "windows.event_id": 21,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "Operation": "Created",
      "Consumer": "CommandLineEventConsumer.Name=\"Updater\"",
      "Filter": "__EventFilter.Name=\"Updater\""
     }
    }
   ]
  }
 ],
 "near_miss": [
  {
   "name": "run key for an installed program",
   "events": [
    {
     "fields": {
      "windows.event_id": 13,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "TargetObject": "HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\OneDrive",
      "Details": "C:\\Program Files\\Microsoft OneDrive\\OneDrive.exe /background"
     }
    }
   ]
  },
  {
   "name": "shortcut in another Start Menu folder",
   "events": [
    {
     "fields": {
      "windows.event_id": 11,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "TargetFilename": "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Accessories\\Notepad.lnk"
     }
    }
   ]
  },
  {
   "name": "WMI filter alone",
   "events": [
    {
     "fields": {
      "windows.event_id": 19,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "Operation": "Created",
      "Name": "Updater",
      "Query": "SELECT * FROM __InstanceModificationEvent"
     }
    }
   ]
  }
 ]
}
