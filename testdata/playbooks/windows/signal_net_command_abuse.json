{
 "playbook": "signal_net_command_abuse",
 "fires": [
  {
   "rule": "Net Domain Group Enumeration",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\net.exe",
      "CommandLine": "net group \"Domain Admins\" /domain",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "Net User Add",
